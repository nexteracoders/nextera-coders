# ==============================================================================
# NextEra Coders Learning Platform — Server Environment Variables Template
# Copy this file to .env and configure values for your environment.
# NEVER commit actual secrets or credentials to source control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# URLs & Origins
CLIENT_URL=https://nexteracoders.com
SERVER_URL=https://api.nexteracoders.com

# Database Connection (MongoDB Atlas or Self-Hosted)
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nextera_coders?retryWrites=true&w=majority
# Configurable DNS servers for MongoDB SRV resolution (fixes Node.js c-ares querySrv ECONNREFUSED on Windows)
# Comma-separated list of IPv4/IPv6 DNS servers. Defaults to system resolver if omitted.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Authentication Secrets
JWT_SECRET=your_super_secret_high_entropy_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=nextera_auth_token

# Seed Account Configuration (For initialization / demo setup)
ADMIN_SEED_EMAIL=admin@nexteracoders.com
ADMIN_SEED_PASSWORD=ChangeMeInProduction!123
STUDENT_SEED_EMAIL=student@nexteracoders.com
STUDENT_SEED_PASSWORD=ChangeMeInProduction!123
