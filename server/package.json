{
  "name": "nextera-coders-server",
  "version": "1.0.0",
  "description": "NextEra Coders Learning Platform API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true, force:true});\" && tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "seed": "tsx src/config/seed.ts",
    "seed:dsa": "tsx src/scripts/seedDsaProblems.ts",
    "db:benchmark": "tsx src/scripts/benchmarkIndexes.ts",
    "test:security": "tsx src/scripts/verifyAllSecurity.ts",
    "test:nec-ai": "tsx src/scripts/verifyNecAi.ts"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "pdf-parse": "^2.4.5",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
